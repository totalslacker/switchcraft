+        let commit = std::env::var("WITCHCRAFT_COMMIT")
+            .unwrap_or_else(|_| "UNKNOWN".to_string());
+        let now = chrono::Utc::now().to_rfc3339();
+
+        // Emit JSON between markers so the runner can grep/sed it out
+        // of stdout without depending on cargo's test-output framing.
+        println!("---SWITCHCRAFT-FIXTURE-BEGIN---");
+        println!("{{");
+        println!("  \"provenance\": {{");
+        println!("    \"witchcraftCommit\": \"{commit}\",");
+        println!("    \"generatedAt\": \"{now}\",");
+        println!("    \"computeUnits\": \"all\",");
+        println!("    \"k\": 32,");
+        println!("    \"tPrime\": 40000,");
+        println!("    \"threshold\": 0.0");
+        println!("  }},");
+        println!("  \"facts\": [");
+        for (i, body) in FACTS.iter().enumerate() {
+            let escaped = body.replace('\\', "\\\\").replace('"', "\\\"");
+            let comma = if i + 1 < FACTS.len() { "," } else { "" };
+            println!("    \"{escaped}\"{comma}");
+        }
+        println!("  ],");
+        println!("  \"queries\": [");
+        for (qi, (q, _)) in QUERIES.iter().enumerate() {
