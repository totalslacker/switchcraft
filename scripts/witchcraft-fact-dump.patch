+            let qcomma = if qi + 1 < QUERIES.len() { "," } else { "" };
+            println!("      ]");
+            println!("    }}{qcomma}");
+        }
+        println!("  ]");
+        println!("}}");
+        println!("---SWITCHCRAFT-FIXTURE-END---");
+
+        db.clear();
+        db.shutdown();
+        Ok(())
+    }
