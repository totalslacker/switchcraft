+    fn dump_facts_corpus_fixture() -> std::io::Result<()> {
+        let dir = tempdir().unwrap();
+        let path: PathBuf = dir.path().join("warp");
+        let mut db = DB::new(path.clone()).unwrap();
+        let device = crate::make_device();
+        let assets = std::path::PathBuf::from(concat!(env!("CARGO_MANIFEST_DIR"), "/assets"));
+        let embedder = crate::Embedder::new(&device, &assets).unwrap();
+
+        // Same indexing flow as test_end_to_end. We use the original
+        // FACTS array verbatim (including the duplicate at index 16),
+        // so document identity must be derived from the stable array
+        // index rather than the body text — otherwise the duplicate
+        // collapses into one UUID and the corpus loses a document.
+        // Switchcraft inserts documents with ids "0".."32" without
+        // such collapsing, and this side must match.
+        for (idx, body) in FACTS.iter().enumerate() {
+            let doc_id = idx.to_string();
+            let uuid = Uuid::new_v5(&Uuid::NAMESPACE_OID, doc_id.as_bytes());
+            db.add_doc(&uuid, None, &doc_id, body, None).unwrap();
+        }
+        crate::embed_chunks(&db, &embedder, None).unwrap();
+        crate::index_chunks(&db, &device).unwrap();
+
+        // Stable git SHA of the Witchcraft tree the helper was applied
